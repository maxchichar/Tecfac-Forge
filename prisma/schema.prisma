// Prisma schema for Tecfac Forge.
// See docs/project-learning.md for migration and existing-database baseline instructions.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Auth (Better Auth core tables — https://better-auth.com)
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  workspaces    WorkspaceMember[]
  progress      Progress[]
  notes         Note[]
  bookmarks     Bookmark[]
  studySessions StudySession[]
  practiceAttempts PracticeAttempt[]
  conceptMasteries ConceptMastery[]
  projectSubmissions ProjectSubmission[] @relation("LearnerSubmissions")
  projectReviews ProjectSubmission[] @relation("SubmissionReviewer")
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  providerId            String
  accountId             String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  ipAddress String?
  userAgent String?
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

// ---------------------------------------------------------------------------
// Product domain
// ---------------------------------------------------------------------------

model Workspace {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())

  members      WorkspaceMember[]
  courses      Course[]
  analysisRuns AnalysisRun[]
  concepts     Concept[]
  practiceAttempts PracticeAttempt[]
  conceptMasteries ConceptMastery[]
}

model WorkspaceMember {
  id          String   @id @default(cuid())
  workspaceId String
  userId      String
  role        String   @default("member") // owner | admin | member

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
}

enum Difficulty {
  beginner
  intermediate
  advanced
}

enum ImportSource {
  github
  zip
  markdown_folder
  gitbook
  docusaurus
  mintlify
  html
}

model Course {
  id             String       @id @default(cuid())
  workspaceId    String
  slug           String       @unique
  title          String
  description    String
  repository     String?
  language       String?
  difficulty     Difficulty   @default(beginner)
  estimatedHours Int          @default(0)
  tags           String[]
  importSource   ImportSource @default(github)
  license        String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  workspace             Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  modules               Module[]
  projects              Project[]
  analysisRuns          AnalysisRun[]
  concepts              Concept[]
  conceptRelationships ConceptRelationship[]

  @@unique([workspaceId, repository])
}

model Module {
  id       String @id @default(cuid())
  courseId String
  title    String
  order    Int

  course  Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons Lesson[]
}

model Lesson {
  id                String     @id @default(cuid())
  moduleId          String
  slug              String
  title             String
  markdown          String
  estimatedMinutes  Int        @default(10)
  difficulty        Difficulty @default(beginner)
  order             Int
  createdAt         DateTime   @default(now())
  sourcePath        String?
  sourceUrl         String?
  sourceRevision    String?

  module          Module            @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  progress        Progress[]
  notes           Note[]
  bookmarks       Bookmark[]
  quizzes         Quiz[]
  flashcards      Flashcard[]
  conceptEvidence ConceptEvidence[]
  projectMilestones ProjectMilestone[]

  @@unique([moduleId, slug])
}

enum ProjectStatus {
  not_started
  in_progress
  submitted
  reviewed
}

model Project {
  id             String        @id @default(cuid())
  courseId       String
  slug           String
  title          String
  description    String
  status         ProjectStatus @default(not_started)
  difficulty     Difficulty    @default(beginner)
  estimatedHours Int           @default(1)
  objectives     String[]
  requirements   String[]
  hints          String[]
  createdAt      DateTime @default(now())

  course    Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  checklist ChecklistItem[]
  bookmarks Bookmark[]
  milestones ProjectMilestone[]

  @@unique([courseId, slug])
}

// Project definitions are workspace-shared; all learner evidence is per user.
model ProjectMilestone {
  id          String @id @default(cuid())
  projectId   String
  title       String
  brief       String
  order       Int
  criteria    String[]
  project     Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sources     Lesson[]
  submissions ProjectSubmission[]

  @@unique([projectId, order])
}

enum SubmissionStatus {
  needs_revision
  submitted
  self_checked
  accepted
}

model ProjectSubmission {
  id                String @id @default(cuid())
  milestoneId       String
  userId            String
  artifact          String
  explanation       String
  verification      String
  criterionEvidence String[]
  status            SubmissionStatus
  feedback          String
  reviewerId        String?
  reviewedAt        DateTime?
  createdAt         DateTime @default(now())
  milestone         ProjectMilestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  user              User @relation("LearnerSubmissions", fields: [userId], references: [id], onDelete: Cascade)
  reviewer          User? @relation("SubmissionReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)

  @@index([userId, milestoneId, createdAt])
  @@index([milestoneId, status])
}

model ChecklistItem {
  id        String  @id @default(cuid())
  projectId String
  label     String
  done      Boolean @default(false)
  order     Int     @default(0)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Progress {
  id          String   @id @default(cuid())
  userId      String
  lessonId    String
  completed   Boolean  @default(false)
  completedAt DateTime?

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
}

model Note {
  id        String   @id @default(cuid())
  userId    String
  lessonId  String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
}

enum BookmarkType {
  lesson
  project
  section
}

model Bookmark {
  id        String       @id @default(cuid())
  userId    String
  type      BookmarkType
  lessonId  String?
  projectId String?
  sectionId String?
  createdAt DateTime     @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson  Lesson?  @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Quiz {
  id        String   @id @default(cuid())
  lessonId  String
  question  String
  choices   String[]
  answer    Int
  createdAt DateTime @default(now())

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
}

model Flashcard {
  id       String @id @default(cuid())
  lessonId String
  front    String
  back     String

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
}

model StudySession {
  id        String   @id @default(cuid())
  userId    String
  startedAt DateTime @default(now())
  endedAt   DateTime?
  minutes   Int       @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// P2 Source Intelligence (Knowledge Model)
// ---------------------------------------------------------------------------

enum AnalysisStatus {
  pending
  processing
  completed
  failed
}

enum ConceptImportance {
  foundational
  core
  advanced
}

enum RelationshipType {
  prerequisite
  depends_on
  related_to
  implements
  uses
}

model AnalysisRun {
  id                 String         @id @default(cuid())
  courseId           String
  workspaceId        String
  status             AnalysisStatus @default(pending)
  version            String         @default("1.0.0")
  model              String?
  sourceRevision     String?
  errorMessage       String?
  conceptsCount      Int            @default(0)
  relationshipsCount Int            @default(0)
  durationMs         Int?
  startedAt          DateTime       @default(now())
  completedAt        DateTime?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  course    Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([courseId])
  @@index([workspaceId])
}

model Concept {
  id          String            @id @default(cuid())
  courseId    String
  workspaceId String
  name        String
  slug        String
  description String
  importance  ConceptImportance @default(core)
  confidence  Float             @default(1.0)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  course            Course                @relation(fields: [courseId], references: [id], onDelete: Cascade)
  workspace         Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  evidence          ConceptEvidence[]
  fromRelationships ConceptRelationship[] @relation("FromConcept")
  toRelationships   ConceptRelationship[] @relation("ToConcept")
  practiceAttempts  PracticeAttempt[]
  conceptMasteries  ConceptMastery[]

  @@unique([courseId, slug])
  @@index([courseId])
  @@index([workspaceId])
}

model ConceptEvidence {
  id         String   @id @default(cuid())
  conceptId  String
  filePath   String
  lessonId   String?
  section    String?
  excerpt    String
  confidence Float    @default(1.0)
  createdAt  DateTime @default(now())

  concept Concept @relation(fields: [conceptId], references: [id], onDelete: Cascade)
  lesson  Lesson? @relation(fields: [lessonId], references: [id], onDelete: SetNull)

  @@index([conceptId])
  @@index([lessonId])
}

model ConceptRelationship {
  id              String           @id @default(cuid())
  courseId        String
  sourceConceptId String
  targetConceptId String
  type            RelationshipType @default(related_to)
  confidence      Float            @default(1.0)
  reason          String?
  evidenceExcerpt String?
  createdAt       DateTime         @default(now())

  course        Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  sourceConcept Concept @relation("FromConcept", fields: [sourceConceptId], references: [id], onDelete: Cascade)
  targetConcept Concept @relation("ToConcept", fields: [targetConceptId], references: [id], onDelete: Cascade)

  @@unique([sourceConceptId, targetConceptId, type])
  @@index([courseId])
}

// ---------------------------------------------------------------------------
// P3/P4 Practice, Assessment & Mastery
// ---------------------------------------------------------------------------

enum AttemptType {
  practice
  assessment
}

enum MasteryState {
  not_started
  learning
  demonstrated
  mastered
}

model PracticeAttempt {
  id          String      @id @default(cuid())
  userId      String
  conceptId   String
  workspaceId String
  type        AttemptType @default(practice)
  prompt      String
  response    String
  passed      Boolean     @default(false)
  score       Int         @default(0)
  feedback    String
  strengths   String[]
  missing     String[]
  createdAt   DateTime    @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  concept   Concept   @relation(fields: [conceptId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([userId, conceptId])
  @@index([workspaceId])
  @@index([userId, type])
}

model ConceptMastery {
  id             String       @id @default(cuid())
  userId         String
  conceptId      String
  workspaceId    String
  state          MasteryState @default(not_started)
  bestScore      Int          @default(0)
  attemptsCount  Int          @default(0)
  demonstratedAt DateTime?
  masteredAt     DateTime?
  updatedAt      DateTime     @updatedAt
  createdAt      DateTime     @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  concept   Concept   @relation(fields: [conceptId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, conceptId])
  @@index([workspaceId])
  @@index([userId, state])
}

