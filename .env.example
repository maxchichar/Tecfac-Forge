# ------------------------------------------------------------------------------
# Tecfac Forge environment variables
# ------------------------------------------------------------------------------
# Copy to `.env` (or `.env.local` for local dev) and fill in real values.
#
#   cp .env.example .env.local
#
# All values below are validated by lib/env.ts before they are used. The app
# FAILS CLOSED: without DATABASE_URL + BETTER_AUTH_SECRET the authenticated
# area of the app shows a configuration screen instead of pretending to work.
#
# Generate a strong auth secret with:
#   openssl rand -base64 32

# --- Required for authentication ---------------------------------------------
# PostgreSQL connection string used by Prisma (and Better Auth).
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
# Secrets must be at least 32 characters. Used to sign session cookies.
BETTER_AUTH_SECRET=

# --- Optional (recommended in production) -------------------------------------
# Public URL of this deployment. Used to build absolute auth URLs.
# BETTER_AUTH_URL=https://forge.example.com
# NEXT_PUBLIC_APP_URL=https://forge.example.com

# --- AI tutor (optional — chat returns 503 "not configured" when absent) ------
# Never commit a real key. Groq powers tutoring, extraction and feedback.
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_FAST_MODEL=openai/gpt-oss-20b
# Shared request budgets, including tutor, analysis and assessment.
# AI_DAILY_USER_LIMIT=60
# AI_DAILY_GLOBAL_LIMIT=1000

# --- Social login (optional — each provider is only enabled when BOTH its id
#     and secret are present; otherwise the button is treated as unavailable) ---
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
